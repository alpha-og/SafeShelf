{
  "name": "safeshelf-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "pnpm install && pnpm backend:sync",
    "mobile:dev": "pnpm --filter mobile dev",
    "dev": "concurrently -n backend,mobile -c cyan,magenta \"pnpm backend:dev\" \"pnpm mobile:dev\"",
    "build": "pnpm --filter mobile build",
    "typecheck": "pnpm --filter mobile typecheck",
    "lint": "pnpm lint:mobile && pnpm lint:backend",
    "lint:mobile": "pnpm --filter mobile lint",
    "lint:backend": "cd backend && uv run ruff check .",
    "format": "pnpm format:mobile && pnpm format:backend",
    "format:mobile": "pnpm --filter mobile format",
    "format:backend": "cd backend && uv run ruff format .",
    "cap:sync": "pnpm --filter mobile cap:sync",
    "cap:android": "pnpm --filter mobile cap:android",
    "dev:setup": "node mobile/scripts/dev.mjs setup",
    "dev:android": "node mobile/scripts/dev.mjs android",
    "dev:ios": "node mobile/scripts/dev.mjs ios",
    "backend:dev": "cd backend && uv run python -m app",
    "backend:serve": "cd backend && uv run python -m app",
    "backend:sync": "cd backend && uv sync",
    "backend:seed": "cd backend && uv run python -m scripts.dev seed"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.3"
  }
}
