# SafeShelf — Shared Configuration
# Copy this file to .env at the repository root.
# Sub-packages (backend/, mobile/) can override values in their own .env files.

# Backend address — shared reference used by both backend and mobile proxy
BACKEND_PORT=8926
BACKEND_HOST=localhost

# USDA FoodData Central API — free, sign up at https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# Hugging Face Space deployment
# HF_TOKEN=
# HF_SPACE_ID=alpha0g/safe_shelf
