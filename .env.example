# SafeShelf — Shared Configuration
# Copy this file to .env at the repository root.
# Sub-packages (backend/, mobile/) can override values in their own .env files.

# --- Backend dev server ---
BACKEND_PORT=8926
BACKEND_HOST=0.0.0.0

# --- Mobile dev server ---
MOBILE_PORT=8826
MOBILE_HOST=true                # true=all interfaces, false=localhost, or IP string
MOBILE_TLS_ENABLED=true         # enables self-signed HTTPS (required for camera on iOS over LAN)

# Proxy — where the mobile dev server forwards /v1 API requests
# Use a LAN IP like http://192.168.1.5:8926 when testing on a real device
VITE_PROXY_TARGET=http://localhost:8926
