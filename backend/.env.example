# SafeShelf configuration
# Copy this file to .env for local dev or set as env vars in production.

# Postgres (production):
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# SQLite (local dev, no Postgres needed):
#   DATABASE_URL=sqlite+aiosqlite:///./safe-shelf-dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security — set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8826

# Server
BACKEND_HOST=localhost
BACKEND_PORT=8926

# Admin API key for /v1/admin/* endpoints
# ADMIN_API_KEY=change-me

# Set DEBUG=false in production to disable hot reload
DEBUG=true

# Set DB_ECHO=false in production to avoid leaking queries in logs
DB_ECHO=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# WHO ICD API
WHO_CLIENT_ID=
WHO_CLIENT_SECRET=

# USDA FoodData Central API (free, sign up at https://fdc.nal.usda.gov/api-key-signup.html)
USDA_FDC_API_KEY=

# Remote Supabase URL for `uv run python -m scripts.dev seed --remote`
# SUPABASE_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ChromaDB persistent storage directory (defaults to ./chroma_db)
# CHROMA_PERSIST_DIR=/data/chroma_db

# HF Space URL for `uv run python -m scripts.dev data --remote`
# Uses ADMIN_API_KEY for auth by default.
# HF_SPACE_URL=https://alpha0g-safe-shelf.hf.space
