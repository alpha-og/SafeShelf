# SafeShelf configuration
# Copy this file to .env for local dev or set as env vars in production.

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security — set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server
HOST=localhost
PORT=8926

# Set DEBUG=false in production to disable hot reload
DEBUG=true

# Set DB_ECHO=false in production to avoid leaking queries in logs
DB_ECHO=false

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
