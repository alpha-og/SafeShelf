# SafeShelf — Mobile Configuration
# Copy this file to .env under mobile/ or set as env vars.

# Vite dev server
MOBILE_PORT=8826
MOBILE_HOST=true                # true=all interfaces, false=localhost, or IP string
MOBILE_TLS_ENABLED=true         # enables self-signed HTTPS (required for camera on iOS over LAN)
DEV_CERTS_MODE=auto             # auto=use mkcert if available, skip=rely on basicSsl fallback

# Backend API proxy — where /v1 requests are forwarded
# Match this to your backend's address (see root .env for BACKEND_HOST/BACKEND_PORT)
VITE_PROXY_TARGET=http://localhost:8926
